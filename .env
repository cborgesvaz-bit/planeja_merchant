# =====================================================================
# Planeja Merchant — configuração local
# Arquivo: .env.local (na raiz do projeto, ao lado do package.json)
# Já coberto pelo .gitignore. NÃO versionar.
# =====================================================================

VITE_SUPABASE_URL=https://vlkvaumpgpisbokisbis.supabase.co

# Chave publishable. É pública por design (vai no bundle do navegador).
# A proteção real é o RLS que você acabou de aplicar + a sessão do usuário.
# ATENÇÃO: esta é a MESMA chave que já estava versionada no repositório.
# Rotacione em Settings > API Keys e substitua o valor abaixo.
VITE_SUPABASE_ANON_KEY=sb_publishable_oeUbuFiu0Hp-5S2Ssr1HvQ_bQrvU7PD

# Domínio corporativo aceito no login.
# Precisa ser IDÊNTICO ao usado na policy de RLS (sql/rls.sql), senão
# você loga com sucesso e mesmo assim não lê nenhum dado.
VITE_ALLOWED_EMAIL_DOMAIN=magazineluiza.com.br
